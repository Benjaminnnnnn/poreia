{
  "name": "poreia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n client,server \"npm run client:dev\" \"npm run server:dev\"",
    "client:dev": "npm --workspace @poreia/client run dev",
    "server:dev": "npm --workspace @poreia/server run dev",
    "server:deploy": "npm --workspace @poreia/server run deploy",
    "server:typecheck": "npm --workspace @poreia/server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
